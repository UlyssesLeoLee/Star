# Enforce LF line endings for documentation and source code text files
# Overrides core.autocrlf=true on Windows to keep worktree in LF
*.md           text eol=lf
*.txt          text eol=lf
*.adoc         text eol=lf
*.rs           text eol=lf
*.toml         text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.json         text eol=lf
*.sh           text eol=lf eof=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf

# Windows scripts (per 2026-09-08 05:45 JST 维护脚本回归实证):
#   *.bat / *.cmd 必须 CRLF, 不然 cmd.exe 解析会退化
#   *.ps1 / *.psm1 跨平台兼容, CRLF (避免 PowerShell 5.1 解析异常)
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf
*.psm1         text eol=crlf

# Binary files (explicit)
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.zip          binary
*.gz           binary
*.tar          binary
