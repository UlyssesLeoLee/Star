# Star 仓 .env.example 模板 (per 守门 #5 env 安全 + V2 阶段 凭证管理层)
#
# ⚠️ 重要: 这是模板, 不要提交真实凭证
# - 真实 .env 文件在 .gitignore 中, 永远不会被 commit
# - 用户在 Star 设置 UI 自行填入凭证 (per V2 阶段, 守门 #5+#14+#DB-13)
# - 本文件仅作 dev/CI 参考, 真实凭证由 CredentialManager 加密存储 (per crates/star-credential)
#
# 获取方式见各 provider 注释

# ==========================================
# 1. B.5 OpenClaw (LLM agent 编排服务, V2 阶段 F.1 真实集成)
# ==========================================
# 获取方式: OpenClaw 服务后台 → API → 创建 API key → 复制 token
# 真实应用场景: 用户在 Star 设置 UI 填入 (不需要此 env var, 仅 dev 参考)
OPENCLAW_BASE_URL=https://api.openclaw.example.com/v1
OPENCLAW_API_KEY=oc_live_xxxxxxxxxxxxxxxxxxxx

# ==========================================
# 2. B.6 Hermes (消息总线服务, V2 阶段 F.2 真实集成)
# ==========================================
# 获取方式: Hermes 服务后台 → API → 创建 API key → 复制 token
HERMES_BASE_URL=https://api.hermes.example.com/v2/hermes
HERMES_API_KEY=hm_live_xxxxxxxxxxxxxxxxxxxx

# ==========================================
# 3. E.4 KMS 集成 (任选一种, V2 阶段 F.3 真实集成)
# ==========================================

# 3a. HashiCorp Vault (推荐, 自托管)
# 获取方式: vault login → vault token create -policy=star-credential
# Vault server 启动: vault server -dev (本地) 或 vault.hcp.cloud (托管)
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=hvs.xxxxxxxxxxxxxxxxxxxx

# 3b. AWS KMS (AWS 托管)
# 获取方式: AWS Console → IAM → Users → Create access key
# region: KMS 服务所在 region (例如 ap-northeast-1 / us-east-1)
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-northeast-1

# 3c. Azure Key Vault (Azure 托管)
# 获取方式: Azure Portal → App registrations → New registration → Certificates & secrets
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_VAULT_URL=https://star-kv.vault.azure.net/

# 3d. Google Cloud KMS
# 获取方式: GCP Console → IAM & Admin → Service accounts → Create key (JSON)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=star-credential-project

# ==========================================
# 4. 默认 KMS 模式 (per 守门 #5, 凭证未到位时使用 LocalMockKms)
# ==========================================
# 设置为 "true" 使用 LocalMockKms (无真实加密, 仅 dev/test)
# 真实部署时设为 "false" 强制使用真实 KMS
STAR_KMS_USE_LOCAL_MOCK=true
