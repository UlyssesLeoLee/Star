# =====================================================================
# Star Platform — Environment Variables (per ADR-0043-audit-onboarding-failed v0.1)
# =====================================================================
# 重要 (per 守门 #5):
#   - 本文件 .env.example 只列 变量名 + 形态 + 取得元数据, 不含 実値
#   - 実値 填入 .env (git ignore), Mavis 接手 不读 .env 内容
#   - 你 (Ulysses) 填后 确保生效, 然后 commit .env.example (本文件) 即可
#
# Phase 2 audit 真接 (per ADR-0043 §3):
#   既存 audit_audit_event テーブル (T 類 append-only WORM, 16 字段) に
#   POST /api/audit/onboarding-failed 経由で INSERT
#   (per commit 62bc032 ADR + fae5c66 audit_audit_event.md v0.2)
# =====================================================================

# ---- 1. Audit Backend URL (per ADR-0043 §3) ----
# 用途: POST /api/audit/onboarding-failed 送信先
# 形態: http(s)://host:port
# 例: http://localhost:3000
# Phase 1 mock 状態: Mavis 接手 走 MSW handler, 此值 任意
# Phase 2 真接: 実 backend URL (per P3-B 拍板)
AUDIT_BACKEND_URL=http://localhost:3000

# ---- 2. Audit Tenant ID (per ADR-0043 §3) ----
# 用途: 13 類 tenant_id 必帯 (per REQ-SEC-001), audit_audit_event.tenant_id に転記
# 形態: UUID v4 文字列
# Phase 1 mock: 任意 (Mavis 接手 hardcode "tenant-physis-corp")
# Phase 2 真接: ActorContext.tenant_id から 動的取得
AUDIT_TENANT_ID=tenant-physis-corp

# ---- 3. Audit Request ID Header (per ADR-0043 §3, 任意) ----
# 用途: audit_audit_event.request_id に転記 (X-Request-Id 連動)
# 形態: HTTP header 名 (e.g. "X-Request-Id", "X-Correlation-Id")
# 任意: 空なら audit_audit_event.request_id = NULL
AUDIT_REQUEST_ID_HEADER=X-Request-Id

# ---- 4. Audit Backend Timeout (任意, 補完) ----
# 用途: POST タイムアウト (ms)
# 形態: 整数 (e.g. 5000 = 5s)
# 任意: 未設定時 10s (per ADR-0042 §1.3 5 retry fetch 10s timeout)
AUDIT_BACKEND_TIMEOUT_MS=10000

# ---- 5. Audit Onboarding 5 Retry Disabled (任意, 補完) ----
# 用途: true 时 OnboardingGuard 走 1 attempt 不重试, false 时 5 retry
# 形態: "true" | "false"
# 任意: 未設定時 false (5 retry, per ADR-0042 §1.3)
AUDIT_ONBOARDING_RETRY_ENABLED=true

# ---- 6. Onboarding Audit Failure Mode (任意, 補完) ----
# 用途: audit 写入失败時の behavior
# 形態: "silent" | "console" | "throw"
# 任意: 未設定時 "silent" (per ADR-0043 §2.4 frontend bridge fallback)
AUDIT_FAILURE_MODE=silent

# =====================================================================
# 4 必备 LLM Provider API Keys (per 2026-09-02 02:49 JST 拍板)
# 重要: キー値 実填, .env に (git ignore)
# 既存 /settings/api-keys encrypted_rust 保存 と 両用可
# =====================================================================

# OpenAI (per 4 必备之一)
# 取得元: https://platform.openai.com/account/api-keys
# 例: sk-...
OPENAI_API_KEY=

# Anthropic Claude (per 4 必备之一)
# 取得元: https://console.anthropic.com/settings/keys
# 例: sk-ant-...
ANTHROPIC_API_KEY=

# Google Gemini (per 4 必备之一)
# 取得元: https://aistudio.google.com/app/apikey
# 例: AIza...
GOOGLE_API_KEY=

# minimax (per 4 必备之一, 新加 provider)
# 取得元: https://api.minimax.chat (Phase 2 provider 詳装時 填入)
minimax_API_KEY=

# =====================================================================
# 兼容旧 Provider (任意, /settings/api-keys 沿用)
# =====================================================================

# OpenClaw (CLI tool, 非 LLM)
OPENCLAW_API_KEY=

# Hermes (CLI tool, 非 LLM)
HERMES_API_KEY=

# =====================================================================
# Mavis 接手が参照しない変数 (守門 #5 厳守, 値 不読):
#   - すべての *_API_KEY
#   - AUDIT_TENANT_ID の中身
#   - AUDIT_BACKEND_URL の中身
#   - 任意他 secret / token / password
# =====================================================================
